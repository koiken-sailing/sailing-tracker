{
  "rules": {
    ".read": false,
    ".write": false,

    "members": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.val() === 'ここに合言葉を入れる'"
      }
    },

    "live": {
      "$day": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && (!data.exists() || data.child('u').val() === auth.uid) && (!newData.exists() || newData.child('u').val() === auth.uid)",
          ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $id.length <= 24 && newData.hasChildren(['u', 's', 'n', 'o', 't', 'p'])",
          "u": { ".validate": "newData.isString()" },
          "s": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "n": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "o": { ".validate": "newData.isBoolean()" },
          "t": { ".validate": "newData.isNumber()" },
          "p": { ".validate": "newData.isString() && newData.val().length < 2000" },
          "m": { ".validate": "newData.isString() && newData.val().length < 20000" },
          "$other": { ".validate": false }
        }
      }
    },

    "liveTrail": {
      "$day": {
        "$id": {
          ".read": true,
          ".write": "auth != null && root.child('live').child($day).child($id).child('u').val() === auth.uid",
          "$min": { ".validate": "newData.isString() && newData.val().length < 4000 && $min.length <= 12" }
        }
      }
    },

    "titles": {
      ".read": true,
      "$day": {
        ".write": "auth != null && root.child('members').child(auth.uid).exists()",
        ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && newData.isString() && newData.val().length <= 30"
      }
    },

    "days": {
      ".read": true,
      "$day": {
        "$id": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
          ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $id.length <= 24 && newData.hasChildren(['uid', 'sail', 'nick', 'ops', 'first', 'last', 'n'])",
          "uid": { ".validate": "newData.isString()" },
          "sail": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "ops": { ".validate": "newData.isBoolean()" },
          "first": { ".validate": "newData.isNumber()" },
          "last": { ".validate": "newData.isNumber()" },
          "n": { ".validate": "newData.isNumber() && newData.val() <= 50000" },
          "$other": { ".validate": false }
        }
      }
    },

    "tracks": {
      "$day": {
        ".read": true,
        "$id": {
          ".write": "auth != null && root.child('members').child(auth.uid).exists() && (!data.exists() || data.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)",
          ".validate": "$day.matches(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$/) && $id.length <= 24 && newData.hasChildren(['v', 'uid', 'sail', 'nick', 'ops', 'first', 'last', 'n', 'f', 'm'])",
          "v": { ".validate": "newData.isNumber()" },
          "uid": { ".validate": "newData.isString()" },
          "sail": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "nick": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "ops": { ".validate": "newData.isBoolean()" },
          "first": { ".validate": "newData.isNumber()" },
          "last": { ".validate": "newData.isNumber()" },
          "n": { ".validate": "newData.isNumber() && newData.val() <= 50000" },
          "f": { ".validate": "newData.isString() && newData.val().length < 600000" },
          "m": { ".validate": "newData.isString() && newData.val().length < 20000" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
